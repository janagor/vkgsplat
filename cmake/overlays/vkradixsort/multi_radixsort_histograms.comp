/**
 * VkRadixSort multi-workgroup histogram pass (Mirco Werner), adapted for vkgsplat.
 * Sorts packed uint32 keys: (tile_id << 16) | (depth_bits >> 16).
 * Element count comes from the live instance counter (not full buffer capacity).
 */
#version 460
#extension GL_EXT_descriptor_heap : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

const uint WORKGROUP_SIZE = 256u;
const uint RADIX_SORT_BINS = 256u;

const uint HEAP_UNSORTED_KEYS = 5u;
const uint HEAP_SORTED_KEYS = 7u;
const uint HEAP_SORT_HISTOGRAM = 11u;
const uint KEY_STRIDE = 2u;
const uint KEY_PACKED = 0u;

layout(push_constant, std430) uniform PushConstants {
	uvec2 g_instance_count_addr;
	uint g_capacity;
	uint g_shift;
	uint g_num_blocks_per_workgroup;
	uint g_ping;// 0: sorted→unsorted, 1: unsorted→sorted
	uint _pad0;
	uint _pad1;
};

layout(descriptor_heap, std430) readonly buffer KeysBuffer {
	uint data[];
} keys_buffers[];

layout(descriptor_heap, std430) writeonly buffer HistogramsBuffer {
	uint data[];
} histograms_buffers[];

layout(buffer_reference, std430, buffer_reference_align = 4) buffer InstanceCountRef {
	uint count;
};

shared uint histogram[RADIX_SORT_BINS];

uint num_elements()
{
	InstanceCountRef instance_count = InstanceCountRef(g_instance_count_addr);
	return min(instance_count.count, g_capacity);
}

uint num_workgroups_for(uint n)
{
	uint blocks = max(g_num_blocks_per_workgroup, 1u);
	uint threads = (n + blocks - 1u) / blocks;
	uint wgs = (threads + WORKGROUP_SIZE - 1u) / WORKGROUP_SIZE;
	return max(wgs, 1u);
}

uint load_packed_key(uint element_id)
{
	uint key_base = element_id * KEY_STRIDE;
	if (g_ping == 0u) {
		return keys_buffers[HEAP_SORTED_KEYS].data[key_base + KEY_PACKED];
	}
	return keys_buffers[HEAP_UNSORTED_KEYS].data[key_base + KEY_PACKED];
}

void main()
{
	uint n = num_elements();
	uint num_wgs = num_workgroups_for(n);
	if (gl_WorkGroupID.x >= num_wgs) {
		return;
	}

	if (gl_LocalInvocationID.x < RADIX_SORT_BINS) {
		histogram[gl_LocalInvocationID.x] = 0U;
	}
	barrier();

	for (uint index = 0; index < g_num_blocks_per_workgroup; index++) {
		uint elementId = gl_WorkGroupID.x * g_num_blocks_per_workgroup * WORKGROUP_SIZE
			+ index * WORKGROUP_SIZE + gl_LocalInvocationID.x;
		if (elementId < n) {
			uint bin = (load_packed_key(elementId) >> g_shift) & (RADIX_SORT_BINS - 1u);
			atomicAdd(histogram[bin], 1U);
		}
	}
	barrier();

	if (gl_LocalInvocationID.x < RADIX_SORT_BINS) {
		histograms_buffers[HEAP_SORT_HISTOGRAM].data[RADIX_SORT_BINS * gl_WorkGroupID.x + gl_LocalInvocationID.x] =
			histogram[gl_LocalInvocationID.x];
	}
}
