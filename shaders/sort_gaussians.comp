#version 460
#extension GL_EXT_descriptor_heap : require
#extension GL_EXT_nonuniform_qualifier : enable

// One compare-exchange stage per dispatch. Host issues all (k, j) phases with
// pipeline barriers between them (workgroup barrier cannot sync across groups).

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

const uint HEAP_SORTED_KEYS = 7u;
const uint HEAP_SORTED_VALUES = 8u;

const uint KEY_STRIDE = 2u;
const uint KEY_TILE = 0u;
const uint KEY_DEPTH = 1u;

layout(descriptor_heap, std430) buffer SortedKeysBuffer {
	uint data[];
} sorted_keys_buffers[];

layout(descriptor_heap, std430) buffer SortedValuesBuffer {
	uint data[];
} sorted_values_buffers[];

layout(push_constant) uniform BitonicPush {
	uint sort_size;
	uint k;
	uint j;
	uint _pad;
} push;

layout(constant_id = 0) const uint SORT_SIZE = 1u;

bool key_less(uint a_base, uint b_base)
{
	uint a_tile = sorted_keys_buffers[HEAP_SORTED_KEYS].data[a_base + KEY_TILE];
	uint b_tile = sorted_keys_buffers[HEAP_SORTED_KEYS].data[b_base + KEY_TILE];
	if (a_tile != b_tile) {
		return a_tile < b_tile;
	}
	uint a_depth = sorted_keys_buffers[HEAP_SORTED_KEYS].data[a_base + KEY_DEPTH];
	uint b_depth = sorted_keys_buffers[HEAP_SORTED_KEYS].data[b_base + KEY_DEPTH];
	return a_depth < b_depth;
}

void swap_entries(uint a, uint b)
{
	uint a_base = a * KEY_STRIDE;
	uint b_base = b * KEY_STRIDE;

	uint a_tile = sorted_keys_buffers[HEAP_SORTED_KEYS].data[a_base + KEY_TILE];
	uint a_depth = sorted_keys_buffers[HEAP_SORTED_KEYS].data[a_base + KEY_DEPTH];
	uint a_value = sorted_values_buffers[HEAP_SORTED_VALUES].data[a];

	sorted_keys_buffers[HEAP_SORTED_KEYS].data[a_base + KEY_TILE] =
		sorted_keys_buffers[HEAP_SORTED_KEYS].data[b_base + KEY_TILE];
	sorted_keys_buffers[HEAP_SORTED_KEYS].data[a_base + KEY_DEPTH] =
		sorted_keys_buffers[HEAP_SORTED_KEYS].data[b_base + KEY_DEPTH];
	sorted_values_buffers[HEAP_SORTED_VALUES].data[a] =
		sorted_values_buffers[HEAP_SORTED_VALUES].data[b];

	sorted_keys_buffers[HEAP_SORTED_KEYS].data[b_base + KEY_TILE] = a_tile;
	sorted_keys_buffers[HEAP_SORTED_KEYS].data[b_base + KEY_DEPTH] = a_depth;
	sorted_values_buffers[HEAP_SORTED_VALUES].data[b] = a_value;
}

void main()
{
	uint i = gl_GlobalInvocationID.x;
	if (i >= SORT_SIZE) {
		return;
	}

	uint ixj = i ^ push.j;
	if (ixj > i && ixj < SORT_SIZE) {
		uint i_base = i * KEY_STRIDE;
		uint j_base = ixj * KEY_STRIDE;
		bool ascending = ((i & push.k) == 0u);
		bool out_of_order = ascending ? key_less(j_base, i_base) : key_less(i_base, j_base);
		if (out_of_order) {
			swap_entries(i, ixj);
		}
	}
}
