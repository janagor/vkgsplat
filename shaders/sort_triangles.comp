#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer ColorBuffer {
	float colors[];
};

struct SortEntry {
	float luminance;
	uint index;
};

layout(std430, binding = 1) buffer SortBuffer {
	SortEntry entries[];
};

layout(std430, binding = 2) writeonly buffer SortedIndices {
	uint indices[];
};

const uint TRIANGLE_COUNT = 144u;
const uint SORT_SIZE = 256u;

float triangle_luminance(uint tri)
{
	float lum = 0.0;
	for (uint v = 0u; v < 3u; ++v) {
		uint idx = tri * 3u + v;
		vec3 c = vec3(colors[idx * 3u + 0u], colors[idx * 3u + 1u], colors[idx * 3u + 2u]);
		lum += dot(c, vec3(0.299, 0.587, 0.114));
	}
	return lum / 3.0;
}

void main()
{
	uint id = gl_GlobalInvocationID.x;

	if (id < SORT_SIZE) {
		if (id < TRIANGLE_COUNT) {
			entries[id].luminance = triangle_luminance(id);
			entries[id].index = id;
		} else {
			entries[id].luminance = 1.0e10;
			entries[id].index = 0u;
		}
	}

	memoryBarrierBuffer();
	barrier();

	for (uint k = 2u; k <= SORT_SIZE; k <<= 1u) {
		for (uint j = k >> 1u; j > 0u; j >>= 1u) {
			uint i = id;
			uint ixj = i ^ j;
			if (ixj > i) {
				bool ascending = ((i & k) == 0u);
				bool should_swap = ascending
					? (entries[i].luminance > entries[ixj].luminance)
					: (entries[i].luminance < entries[ixj].luminance);
				if (should_swap) {
					SortEntry tmp = entries[i];
					entries[i] = entries[ixj];
					entries[ixj] = tmp;
				}
			}
			memoryBarrierBuffer();
			barrier();
		}
	}

	if (id < TRIANGLE_COUNT) { indices[id] = entries[id].index; }
}
