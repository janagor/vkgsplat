#version 460
#extension GL_EXT_descriptor_heap : require
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Heap slot indices must match HeapSlot in descriptor_heap.hpp.
const uint HEAP_POSITION = 0u;
const uint HEAP_COLOR = 1u;
const uint HEAP_SORTED_INDICES = 2u;
const uint HEAP_SORT_ENTRIES = 3u;

layout(descriptor_heap, std430) buffer PositionBuffer {
	vec3 positions[];
} position_buffers[];

layout(descriptor_heap, std430) buffer ColorBuffer {
	vec3 colors[];
} color_buffers[];

layout(descriptor_heap, std430) writeonly buffer SortedIndices {
	uint indices[];
} sorted_index_buffers[];

struct SortEntry {
	float luminance;
	uint index;
};

layout(descriptor_heap, std430) buffer SortBuffer {
	SortEntry entries[];
} sort_buffers[];

layout(constant_id = 0) const uint SPHERE_COUNT = 1u;
layout(constant_id = 1) const uint SORT_SIZE = 1u;
layout(constant_id = 2) const uint PROCEDURAL = 0u;

uint hash_u32(uint x)
{
	x ^= x >> 16u;
	x *= 0x7feb352du;
	x ^= x >> 15u;
	x *= 0x846ca68bu;
	x ^= x >> 16u;
	return x;
}

float hash_f01(uint x) { return float(hash_u32(x)) / 4294967295.0; }

vec3 random_color(uint seed)
{
	return vec3(
		mix(0.05, 1.0, hash_f01(seed * 1664525u + 1013904223u)),
		mix(0.05, 1.0, hash_f01(seed * 22695477u + 1u)),
		mix(0.05, 1.0, hash_f01(seed * 1103515245u + 12345u)));
}

float sphere_luminance(vec3 c)
{
	return dot(c, vec3(0.299, 0.587, 0.114));
}

void main()
{
	uint id = gl_GlobalInvocationID.x;

	if (id < SPHERE_COUNT) {
		if (PROCEDURAL != 0u) {
			color_buffers[HEAP_COLOR].colors[id] = random_color(id);
			float t = float(id) / float(max(SPHERE_COUNT, 2u) - 1u);
			float x = mix(-4.0, 4.0, t);
			float y = mix(-1.5, 1.5, hash_f01(id * 48271u + 3u));
			float z = mix(-2.0, 2.0, hash_f01(id * 69621u + 11u));
			position_buffers[HEAP_POSITION].positions[id] = vec3(x, y, z);
		}

		sort_buffers[HEAP_SORT_ENTRIES].entries[id].luminance =
			sphere_luminance(color_buffers[HEAP_COLOR].colors[id]);
		sort_buffers[HEAP_SORT_ENTRIES].entries[id].index = id;
	} else if (id < SORT_SIZE) {
		sort_buffers[HEAP_SORT_ENTRIES].entries[id].luminance = 1.0e10;
		sort_buffers[HEAP_SORT_ENTRIES].entries[id].index = 0u;
	}

	memoryBarrierBuffer();
	barrier();

	for (uint k = 2u; k <= SORT_SIZE; k <<= 1u) {
		for (uint j = k >> 1u; j > 0u; j >>= 1u) {
			uint i = id;
			uint ixj = i ^ j;
			if (ixj > i) {
				float lum_i = sort_buffers[HEAP_SORT_ENTRIES].entries[i].luminance;
				float lum_j = sort_buffers[HEAP_SORT_ENTRIES].entries[ixj].luminance;
				bool ascending = ((i & k) == 0u);
				bool should_swap = ascending ? (lum_i > lum_j) : (lum_i < lum_j);
				if (should_swap) {
					uint idx_i = sort_buffers[HEAP_SORT_ENTRIES].entries[i].index;
					uint idx_j = sort_buffers[HEAP_SORT_ENTRIES].entries[ixj].index;
					sort_buffers[HEAP_SORT_ENTRIES].entries[i].luminance = lum_j;
					sort_buffers[HEAP_SORT_ENTRIES].entries[i].index = idx_j;
					sort_buffers[HEAP_SORT_ENTRIES].entries[ixj].luminance = lum_i;
					sort_buffers[HEAP_SORT_ENTRIES].entries[ixj].index = idx_i;
				}
			}
			memoryBarrierBuffer();
			barrier();
		}
	}

	if (id < SPHERE_COUNT) {
		sorted_index_buffers[HEAP_SORTED_INDICES].indices[id] =
			sort_buffers[HEAP_SORT_ENTRIES].entries[id].index;
	}
}
