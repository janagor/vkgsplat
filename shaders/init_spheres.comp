#version 460
#extension GL_EXT_descriptor_heap : require
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Heap slot indices must match HeapSlot in descriptor_heap.hpp.
const uint HEAP_GEOMETRY = 0u;
const uint HEAP_APPEARANCE = 1u;
const uint HEAP_SORTED_INDICES = 2u;
const uint HEAP_SORT_ENTRIES = 3u;

// Flat packing must match GaussianGeometry / GaussianAppearance in gaussian_splat.hpp.
const uint GEOMETRY_STRIDE = 11u;
const uint GEOM_POS = 0u;
const uint GEOM_SCALE = 3u;
const uint GEOM_ROT = 6u;
const uint GEOM_OPACITY = 10u;

const uint APPEARANCE_STRIDE = 48u;
const uint APP_F_DC = 0u;
const uint APP_F_REST = 3u;
const uint APP_F_REST_COUNT = 45u;

layout(descriptor_heap, std430) buffer GeometryBuffer {
	float data[];
} geometry_buffers[];

layout(descriptor_heap, std430) buffer AppearanceBuffer {
	float data[];
} appearance_buffers[];

layout(descriptor_heap, std430) writeonly buffer SortedIndices {
	uint indices[];
} sorted_index_buffers[];

struct SortEntry {
	float luminance;
	uint index;
};

layout(descriptor_heap, std430) buffer SortBuffer {
	SortEntry entries[];
} sort_buffers[];

layout(constant_id = 0) const uint SPHERE_COUNT = 1u;
layout(constant_id = 1) const uint SORT_SIZE = 1u;

const float SH_C0 = 0.28209479177387814;

float sigmoid(float x)
{
	return 1.0 / (1.0 + exp(-x));
}

vec3 sh0_to_rgb(vec3 f_dc)
{
	return clamp(vec3(0.5) + SH_C0 * f_dc, 0.0, 1.0);
}

float sphere_luminance(vec3 c)
{
	return dot(c, vec3(0.299, 0.587, 0.114));
}

void main()
{
	uint id = gl_GlobalInvocationID.x;

	if (id < SPHERE_COUNT) {
		uint geom_base = id * GEOMETRY_STRIDE;
		uint app_base = id * APPEARANCE_STRIDE;

		vec3 f_dc = vec3(
			appearance_buffers[HEAP_APPEARANCE].data[app_base + APP_F_DC],
			appearance_buffers[HEAP_APPEARANCE].data[app_base + APP_F_DC + 1u],
			appearance_buffers[HEAP_APPEARANCE].data[app_base + APP_F_DC + 2u]);
		vec3 rgb = sh0_to_rgb(f_dc);
		float opacity = sigmoid(geometry_buffers[HEAP_GEOMETRY].data[geom_base + GEOM_OPACITY]);
		sort_buffers[HEAP_SORT_ENTRIES].entries[id].luminance = sphere_luminance(rgb) * opacity;
		sort_buffers[HEAP_SORT_ENTRIES].entries[id].index = id;
	} else if (id < SORT_SIZE) {
		sort_buffers[HEAP_SORT_ENTRIES].entries[id].luminance = 1.0e10;
		sort_buffers[HEAP_SORT_ENTRIES].entries[id].index = 0u;
	}

	memoryBarrierBuffer();
	barrier();

	for (uint k = 2u; k <= SORT_SIZE; k <<= 1u) {
		for (uint j = k >> 1u; j > 0u; j >>= 1u) {
			uint i = id;
			uint ixj = i ^ j;
			if (ixj > i) {
				float lum_i = sort_buffers[HEAP_SORT_ENTRIES].entries[i].luminance;
				float lum_j = sort_buffers[HEAP_SORT_ENTRIES].entries[ixj].luminance;
				bool ascending = ((i & k) == 0u);
				bool should_swap = ascending ? (lum_i > lum_j) : (lum_i < lum_j);
				if (should_swap) {
					uint idx_i = sort_buffers[HEAP_SORT_ENTRIES].entries[i].index;
					uint idx_j = sort_buffers[HEAP_SORT_ENTRIES].entries[ixj].index;
					sort_buffers[HEAP_SORT_ENTRIES].entries[i].luminance = lum_j;
					sort_buffers[HEAP_SORT_ENTRIES].entries[i].index = idx_j;
					sort_buffers[HEAP_SORT_ENTRIES].entries[ixj].luminance = lum_i;
					sort_buffers[HEAP_SORT_ENTRIES].entries[ixj].index = idx_i;
				}
			}
			memoryBarrierBuffer();
			barrier();
		}
	}

	if (id < SPHERE_COUNT) {
		sorted_index_buffers[HEAP_SORTED_INDICES].indices[id] =
			sort_buffers[HEAP_SORT_ENTRIES].entries[id].index;
	}
}
